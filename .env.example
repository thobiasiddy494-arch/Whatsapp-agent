# Nakili faili hii kuwa ".env" kisha jaza thamani zako halisi

# Chagua token yoyote (mfano: neno la siri lako mwenyewe) - itumike wakati
# wa kusetup webhook kwenye Meta App Dashboard
VERIFY_TOKEN=weka_neno_lako_la_siri_hapa

# Kutoka Meta Business Suite / Meta for Developers > WhatsApp > API Setup
WHATSAPP_TOKEN=weka_access_token_ya_meta_hapa
WHATSAPP_PHONE_NUMBER_ID=weka_phone_number_id_hapa

# Kutoka console.anthropic.com > API Keys
ANTHROPIC_API_KEY=weka_anthropic_api_key_hapa

PORT=3000
